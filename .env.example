# 复制为 .env 后按需填写；程序不会读取或提交真实凭据。
OPENAI_API_KEY=
GEO_MODEL=gpt-5.4-mini

# 仅在使用 webhook 发布时需要
HONGTU_CMS_TOKEN=

# 可选：OpenAI 兼容的第三方模型端点密钥
DEEPSEEK_API_KEY=

# GEO 匿名归因哈希盐；生产环境应使用独立随机值，切勿填写手机号或用户信息
HONGTU_ATTRIBUTION_SALT=
# 至少 32 字节；用于验证 NewHongTU 发往 GEO 的匿名事件签名，双方配置同一密钥。
HONGTU_ATTRIBUTION_INGEST_SECRET=
